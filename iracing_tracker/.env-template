# Credenciales de iRacing
# Rellena con tus datos y renombra este archivo a .env

# Tu email de iRacing
IRACING_EMAIL=tu_email@ejemplo.com

# Tu contraseña de iRacing
IRACING_PASSWORD=tu_contraseña

# Tu Customer ID (lo encuentras en tu perfil de iRacing)
# Ve a: Members Site > My Account > Customer ID
IRACING_CUST_ID=123456
